# ── OKD Cluster Credentials & Ignition ───────────────────────────────────────
# Generated fresh each session by lab-up.sh — never commit.
# Contains kubeadmin password, kubeconfig, and base64-encoded secrets.
cluster-config/

# ── Terraform ────────────────────────────────────────────────────────────────
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
.terraform.tfstate.lock.info
.terraformrc
terraform.rc

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Keep terraform.tfvars in version control (non-secret config lives there).
# Add a .local variant for any secrets you don't want committed.
*.tfvars.local

# ── SSH Keys ─────────────────────────────────────────────────────────────────
*.pem
*.key
id_rsa*
id_ed25519*

# ── openshift-install artifacts ──────────────────────────────────────────────
.openshift_install.log
.openshift_install_state.json

